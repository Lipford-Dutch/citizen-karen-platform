# Backend runtime. Compose supplies a local Postgres URL; SQLite remains a
# zero-dependency fallback for focused backend development and tests.
APP_ENV=local
DATABASE_URL=sqlite:///data/citizen-karen.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEMO_MODE=true
ASYNC_SUBMISSIONS=false
JWT_SECRET=replace-before-any-shared-deployment
REDIS_URL=redis://localhost:6379/0
# Exact comma-separated hosts permitted to use cleartext transport in staging/production.
# Leave empty unless the hosts are on a controlled internal network.
INSECURE_INTERNAL_HOSTS=
SUBMISSION_RATE_LIMIT_PER_MINUTE=5

# Keep simulate for local development. Network mode requires an explicitly
# approved endpoint; the Compose stack supplies its own mock URL.
FCC_CONNECTOR_MODE=simulate
FCC_API_URL=http://localhost:8001/fcc/robocall
# Required in staging/production. Comma-separated exact HTTPS endpoints;
# including a non-default port here explicitly allowlists that port.
FCC_APPROVED_ENDPOINTS=
